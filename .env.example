# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection URI string.
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/pakistani_clothing_store?retryWrites=true&w=majority"

# VITE_WHATSAPP_NUMBER: Customer service WhatsApp number (format: country code without +, e.g., 923001234567)
VITE_WHATSAPP_NUMBER="923001234567"

# VITE_API_URL: API base endpoint (default /api for standard same-origin or reverse proxy)
VITE_API_URL="/api"

# CLOUDINARY: Image storage credentials (for Phase 2 image upload)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AUTHENTICATION: Session signing & JWT token encryption
JWT_SECRET="your_jwt_secret_key_change_in_production"

# INITIAL STORE ADMINISTRATOR CREDENTIALS (seeded on first startup if no admin exists)
ADMIN_EMAIL="admin@noorandco.pk"
ADMIN_INITIAL_PASSWORD="ChangeThisPassword2026!"

# EMAIL SERVICE (SMTP) CONFIGURATION FOR PASSWORD RESETS:
# EMAIL_HOST: Default "smtp.gmail.com"
EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT: 587 (TLS/STARTTLS) or 465 (SSL)
EMAIL_PORT="587"
# EMAIL_USER: Your full email address (e.g. yourname@gmail.com)
EMAIL_USER="your-email@gmail.com"
# EMAIL_PASS: CRITICAL: For Gmail, this MUST be a 16-character Google App Password (e.g., abcd efgh ijkl mnop).
# NOT your regular Gmail account login password! (Regular passwords trigger "535-5.7.8 BadCredentials").
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords -> Create "Mail"
EMAIL_PASS="abcdefghijklmnop"
# EMAIL_FROM: Display name and sender address in outgoing emails
EMAIL_FROM="Noor & Co. Luxury Pret <noreply@noorandco.pk>"
# APP_URL: Production domain used for generating password reset links
APP_URL="https://clouth-eco.vercel.app"

